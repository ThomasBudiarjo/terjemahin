# Copy to .env (repo root for docker compose, apps/worker/ for the worker CLI). Every line is
# optional: the values shown are the defaults. Env names are case-insensitive.

# --- shared (api + worker) ---
AMQP_URL=amqp://guest:guest@localhost:5672/
AMQP_QUEUE=terjemahin.jobs
STORAGE_DIR=./data                # job files; the web UI keeps its jobs in $STORAGE_DIR/web

# --- api (Go) ---
API_ADDR=:8080
# DATABASE_URL is passed by docker-compose but not read yet: the job store is in-memory
DATABASE_URL=postgres://terjemahin:terjemahin@localhost:5432/terjemahin?sslmode=disable

# --- worker: default method per stage (`terjemahin-worker methods` lists them) ---
# A job's PipelineConfig, the CLI flags and the web UI override these per page.
DETECTOR=ctd                      # ctd | ctd_blk | yolo | classical
OCR=manga_ocr                     # manga_ocr | manga_ocr_hf | 48px | none
TRANSLATOR=nllb                   # nllb | m2m100 | nllb_big | m2m100_big | local_llm | chain |
                                  # gemini | openai | anthropic | deepseek | ollama | original | none
MASK_REFINER=default              # default | dilate | bbox
INPAINTER=lama_manga              # lama_manga | lama | telea | ns | fill
RENDERER=default                  # default | vertical | basic
OCR_NON_JAPANESE=48px             # OCR used when OCR is unset and the source is not Japanese
# default languages of the web UI form (CLI: --from/--to; API: pipeline.source_lang/target_lang)
SOURCE_LANG=ja
TARGET_LANG=id

# --- worker: limits ---
MAX_PIXELS=50000000               # larger pages are refused before decoding
MIN_OCR_CONFIDENCE=0.4            # OCR reads below this are left untouched
STAGE_CACHE_SIZE=2                # built instances kept per stage (each may hold a model)
WEB_KEEP_JOBS=100                 # web UI jobs kept on disk (~13 MB each); 0 keeps all
DEVICE=cpu                        # torch methods: cpu | cuda | mps

# --- worker: weights and fonts (relative paths resolve against the working directory) ---
# Defaults are apps/worker/weights and apps/worker/fonts, wherever the package lives.
# WEIGHTS_DIR=weights             # downloaded files (weights/README.md)
# YOLO_WEIGHTS=weights/manga-text-yolo11n.onnx     # -d yolo, trained locally
# CTD_WEIGHTS=weights/comictextdetector-blk.onnx   # -d ctd_blk, made by prune-ctd
# FONT_PATH=fonts/ComicShanns2.ttf
DETECT_CONF=0.4                   # ctd / ctd_blk / yolo score threshold
DETECT_IOU=0.5                    # yolo NMS IoU (ctd has its own iou option, default 0.35)
# TERJEMAHIN_OFFLINE=1            # never download weight files (fail instead)
# HF_HUB_OFFLINE=1                # never contact the Hugging Face hub (cached models only)

# --- worker: LLM / API translators (a method shows as unavailable until its key is set) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
OPENAI_API_KEY=                   # any OpenAI-compatible server: also set OPENAI_BASE_URL
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# ollama needs no key; read from the environment only (not from .env):
# OLLAMA_BASE_URL=http://localhost:11434/v1  OLLAMA_MODEL=qwen2.5:7b  OLLAMA_TIMEOUT=900

# --- worker: tuning read from the environment only (not from .env) ---
# SEQ2SEQ_MAX_MODELS=2            # nllb/m2m100 models kept loaded at once
# OCR_THREADS=0                   # manga_ocr onnxruntime threads (0 = all cores)
