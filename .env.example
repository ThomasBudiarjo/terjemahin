# --- shared ---
AMQP_URL=amqp://guest:guest@localhost:5672/
AMQP_QUEUE=terjemahin.jobs
DATABASE_URL=postgres://terjemahin:terjemahin@localhost:5432/terjemahin?sslmode=disable

# --- api (Go) ---
API_ADDR=:8080
STORAGE_DIR=./data

# --- worker (Python) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
DETECTOR=yolo                 # yolo | ctd
YOLO_WEIGHTS=weights/manga-text-yolo11n.onnx
CTD_WEIGHTS=weights/comictextdetector-blk.onnx
FONT_PATH=fonts/default.ttf
