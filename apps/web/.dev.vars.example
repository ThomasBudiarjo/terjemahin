# Copy to .dev.vars for `pnpm dev`; these override wrangler.jsonc vars locally. MONGODB_URI is a
# local MongoDB (`docker compose up -d mongo` at the repo root) or an Atlas connection string. The
# production Clerk key only works on terjemah.in: the console uses the development instance here,
# and with CLERK_JWT_KEY empty `pnpm dev` (never a build) treats every API request as user "dev".
MONGODB_URI=mongodb://localhost:27017
WORKER_TOKEN=dev-worker-token
PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_bmV4dC1zdGluZ3JheS01LmNsZXJrLmFjY291bnRzLmRldiQ
CLERK_JWT_KEY=
